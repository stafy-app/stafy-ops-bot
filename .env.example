# Telegram (BotFather token; allowlist = comma-separated numeric Telegram user IDs, e.g. from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Webhook mode only: must match the secret_token passed to setWebhook. Leave empty for polling.
TELEGRAM_WEBHOOK_SECRET=

# GitHub — fine-grained PAT or GitHub App token: Issues (write) on the repos + Projects (read/write) for the org
GITHUB_TOKEN=
GITHUB_ORG=stafy-app
GITHUB_PROJECT_NUMBER=1

# LLM — any OpenAI-compatible /chat/completions endpoint with JSON mode.
# OpenRouter: https://openrouter.ai/api/v1  (model = e.g. "google/gemini-2.5-flash"; pick from openrouter.ai/models)
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
# DeepSeek: https://api.deepseek.com
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Max clarifying-question rounds before the bot is forced to draft
MAX_QUESTION_ROUNDS=6

# Upstash Redis REST — injected automatically by the Vercel Marketplace integration (either naming works).
# Leave empty locally: long-polling then keeps conversations in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
